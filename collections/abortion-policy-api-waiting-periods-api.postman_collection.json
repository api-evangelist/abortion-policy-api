  "info": {
    "_postman_id": "0129685c-98cd-4417-a324-511c52141766",
    "name": "Abortion Policy Gestational Limits Waiting Periods API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Abortion Policy API provides up-to-date information on state abortion policies that can be integrated into online abortion resources. The API consolidates abortion laws into one database across four data tables: gestational limits, insurance coverage, minors restrictions, and waiting periods. Data is accessible by US state name or zip code. Authentication requires an API key provided upon request.",
      "type": "text/plain"
    }
  }
